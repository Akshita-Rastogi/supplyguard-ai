MCP_SERVER_URL=http://mcp-tools:8001/mcp
MIN_EVIDENCE_SCORE=0.35
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=4000
MEMORY_TTL_HOURS=24
API_KEYS=demo-key:analyst,admin-key:admin
